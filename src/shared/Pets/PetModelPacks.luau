-- Local, dependency-free pet packs. These packs use the project's generated plush
-- geometry, so they are free to ship and do not depend on Marketplace permissions.
local Packs = {
	FreeStarter = {
		Id = "FreeStarter",
		Name = "Free Starter Pet Pack",
		License = "Original project geometry; unrestricted for this project",
		Source = "Generated by PetGeometry.luau",
		AssetMode = "GeneratedPlaceholder",
		Definitions = { "GoldenRetriever", "HouseCat", "Bunny", "Hamster", "GuineaPig" },
		Stages = { "Puppy", "Young", "Adult", "Champion" },
	},
}

function Packs.Get(packId)
	return Packs[packId]
end

return table.freeze(Packs)
